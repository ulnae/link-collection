{
  "manifest_version": 3,
  "name": "链接收集",
  "version": "1.0.0",
  "description": "一键识别页面中的图片、音频、视频、iframe、脚本、样式六大类资源链接，悬浮窗分类展示与复制。",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["link-easy.content.js"],
      "run_at": "document_idle"
    }
  ]
}
