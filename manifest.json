{
  "manifest_version": 3,
  "name": "Link Collection",
  "version": "1.0.1",
  "description": "一键识别页面中的图片、音频、视频、iframe、脚本、样式、字体等资源链接，悬浮窗分类展示、搜索、下载与复制。",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
